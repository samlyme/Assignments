fun makeCounter(seed, step) {
  var count = seed;

  fun next() {
    count = count + step;
    return count;
  }

  return next;
}

var a = makeCounter(0, 1);
var b = makeCounter(100, 3);
var c = makeCounter(1000, 5);

fun run(limit) {
  var i = 0;
  var total = 0;

  while (i < limit) {
    total = total + a() + b() - c();

    if (total < 0) {
      total = -total;
    }

    i = i + 1;
  }

  return total;
}

var start = clock();
var answer = run(7000000);
print clock() - start;
print answer;
