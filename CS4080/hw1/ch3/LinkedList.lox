class Node {
    init(data, next) {
        this.data = data;
        this.next = next;
    }
}

class LinkedListStack {

    init() {
        this.head = nil;
    }

    push(data) {
        if (this.head == nil) {
            this.head = Node(data, nil);
        }
        else {
            var next = Node(data, this.head);
            this.head = next;
        }
    }

    pop() {
        if (this.head == nil) {
            return nil;
        } 
        else {
            var out = this.head;
            this.head = this.head.next;
            return out;
        }
    }
}

var stack = LinkedListStack();
stack.push("first");
stack.push("second");

print stack.pop().data;
print stack.pop().data;
print stack.pop(); // should return n